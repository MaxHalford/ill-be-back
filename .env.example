# The canonical public origin; OAuth callbacks use this exact address.
APP_URL=https://your-app.example.com
PORT=8000
# PostgreSQL is recommended for managed hosting. SQLite requires a persistent volume.
DATABASE_URL=postgres://user:password@host:5432/illbeback?sslmode=require
# Generate: openssl rand -base64 32. Keep stable and back up separately from the DB.
TOKEN_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set true only after Google approves the public app and production publishing is enabled.
GOOGLE_VERIFIED=false
